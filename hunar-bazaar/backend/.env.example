# --- App ---
APP_NAME=Hunar Bazaar
ENV=development

# --- Mongo ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=hunar_bazaar

# --- Redis (OTP + session cache) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# --- OAuth (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# --- AES QR crypto binary (built from /crypto) ---
QR_CRYPTO_BIN=/app/bin/qr_crypto
AES_QR_KEY_HEX=000102030405060708090a0b0c0d0e0f
